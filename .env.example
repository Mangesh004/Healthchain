# ==============================================================================
# HealthChain Master Environment Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file or the respective subdirectory .env.example files:
#   - backend/.env.example -> backend/.env
#   - frontend/.env.example -> frontend/.env
#   - blockchain/.env.example -> blockchain/.env
#
# NEVER COMMIT REAL PRIVATE KEYS, JWT SECRETS, OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Backend)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for signing JWT access tokens
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_for_security_2026
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=your_cookie_signing_secret_high_entropy_2026

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE (Backend & Migrations)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthchain_db
DB_USER=healthchain_user
DB_PASSWORD=healthchain_secure_password

# ------------------------------------------------------------------------------
# 4. MEDICAL RECORD ENCRYPTION & STORAGE (Backend Off-Chain Storage)
# ------------------------------------------------------------------------------
# 32-byte AES-256-GCM master encryption key (64 hexadecimal characters)
FILE_ENCRYPTION_KEY=c4a7f92b18d3e56a7042b8e9102c3d4e5f60718293a4b5c6d7e8f90123456789
STORAGE_PATH=storage/encrypted

# ------------------------------------------------------------------------------
# 5. BLOCKCHAIN & SMART CONTRACT (Backend & Hardhat)
# ------------------------------------------------------------------------------
# Local Hardhat Node RPC URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Deployed HealthcareRecords.sol contract address (generated on deployment)
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Operator account private key (Hardhat standard local account #1 for testing)
BLOCKCHAIN_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BLOCKCHAIN_CHAIN_ID=31337

# ------------------------------------------------------------------------------
# 6. FRONTEND VITE CONFIGURATION (Publicly visible in browser bundle)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_CHAIN_ID=31337
VITE_APP_NAME=HealthChain
